  "houses": [
    { "id": "house_01", "address": "브로드 가 40번지", "x": 1120, "y": 890, "deaths": 6, "primaryPump": "pump_broad", "residentName": "토머스 하글리", "interviewText": "온 식구가 사흘 만에 피를 토하고 갔소... 골목길에서 피어오르는 지독한 악취 때문이오! 창문도 다 닫아걸고 매일 아침 길어온 차가운 물로 목을 축였는데도 소용없었소...", "clueType": "suspect_cluster" },
    { "id": "house_02", "address": "브로드 가 37번지", "x": 1330, "y": 900, "deaths": 4, "primaryPump": "pump_broad", "residentName": "마사 윌킨스", "interviewText": "아이들이 열병에 시달리며 자꾸 목이 마르다고 보채서 문 앞 펌프에서 물을 연신 길어다 먹였는데... 막내가 먼저 숨을 거두더니 남편마저 뒤를 따랐습니다...", "clueType": "suspect_cluster" },
    { "id": "house_03", "address": "브로드 가 52번지", "x": 980, "y": 890, "deaths": 5, "primaryPump": "pump_broad", "residentName": "제임스 오코너", "interviewText": "3층 하숙집 사람들이 한날한시에 앓아누웠소. 시체 썩는 냄새가 골목에 가득하니 다들 공기 탓이라 하지만, 왜 바로 옆 건물 사람들은 괜찮은지 도무지 모르겠소.", "clueType": "suspect_cluster" },
    { "id": "house_04", "address": "케임브리지 가 12번지", "x": 1280, "y": 780, "deaths": 3, "primaryPump": "pump_broad", "residentName": "엘리자 프라이스", "interviewText": "집 뒤편 낡은 정화조 구덩이에서 악취가 진동하더니 결국 화를 당했소. 더러운 공기를 마신 탓이지! 갈증이 너무 심해 큰길가 펌프 물을 몇 사발씩 들이켰다오.", "clueType": "suspect_cluster" },
    { "id": "house_05", "address": "브로드 가 25번지", "x": 1510, "y": 920, "deaths": 4, "primaryPump": "pump_broad", "residentName": "헨리 콜린스", "interviewText": "구두 수선 가게요. 종일 먼지와 가죽 냄새를 마시며 일하니 목이 타서 앞마당 펌프에서 차가운 물을 벌컥벌컥 마시곤 했지. 단골손님들도 그 물을 나눠 마셨는데...", "clueType": "suspect_cluster" },
    { "id": "house_06", "address": "폴란드 가 8번지", "x": 1120, "y": 680, "deaths": 2, "primaryPump": "pump_broad", "residentName": "새러 베넷", "interviewText": "귀족들 빨래를 해주는 하녀요. 빨랫감을 삶고 목을 축이느라 늘 큰길가 물을 길어왔지요. 그 물로 끓인 차를 마신 딸아이가 갑자기 설사를 시작하더니...", "clueType": "suspect_cluster" },
    { "id": "house_07", "address": "드루어리 골목 3번지", "x": 1420, "y": 1120, "deaths": 3, "primaryPump": "pump_broad", "residentName": "윌리엄 터너", "interviewText": "우리 골목 펌프는 물이 미지근하고 탁해서, 조금 멀어도 브로드 가까지 걸어가서 맑고 시원한 물을 떠왔소. 그런데 그 물을 길어온 뒤로 아내가 먼저 쓰러졌소...", "clueType": "suspect_cluster" },
    { "id": "house_08", "address": "워윅 가 14번지", "x": 1020, "y": 1420, "deaths": 2, "primaryPump": "pump_broad", "residentName": "앤 리버스", "interviewText": "동네 사람들은 우리 골목 펌프를 쓰지만, 난 장보러 갈 때마다 맛이 달착지근한 브로드 펌프 물을 물통 가득 담아오곤 했지. 하숙생 둘이 그걸 마시고 죽었어...", "clueType": "suspect_cluster" },
    { "id": "house_09", "address": "딘 가 21번지", "x": 580, "y": 1180, "deaths": 0, "primaryPump": "pump_dean", "residentName": "조지 밀러", "interviewText": "여긴 도살장 냄새 때문에 숨도 못 쉴 지경이지만 신기하게 아픈 사람이 단 한 명도 없소! 공기가 원인이라면 우리 골목부터 전멸했어야 맞지 않소?", "clueType": "normal" },
    { "id": "house_10", "address": "리틀 말버러 가 5번지", "x": 780, "y": 840, "deaths": 0, "primaryPump": "pump_little_marlborough", "residentName": "루시 하트", "interviewText": "시궁창 냄새야 소호 어디나 똑같지요. 하지만 우리 골목 사람들은 집 앞 작은 펌프 물만 마시며 아주 멀쩡하게 지내고 있답니다.", "clueType": "normal" },
    { "id": "house_11", "address": "그레이트 말버러 가 30번지", "x": 740, "y": 500, "deaths": 1, "primaryPump": "pump_great_marlborough", "residentName": "프레더릭 던", "interviewText": "우리 식구들은 다 건강한데, 브로드 가 공사장에서 미장일을 하던 형님 혼자 점심때 쓰러졌소. 목이 마르다고 펌프 물을 들이켠 뒤로 바로 배를 움켜쥐더군...", "clueType": "suspect_cluster" },
    { "id": "house_12", "address": "브라이들 골목 9번지", "x": 1450, "y": 1400, "deaths": 1, "primaryPump": "pump_bridle_lane", "residentName": "메리 가드너", "interviewText": "우리 골목 펌프는 물맛이 이상해서 아이가 안 먹으려 하더군요. 그래서 브로드 가 큰길까지 가서 일부러 길어다 먹였는데... 내 손으로 아이를 해친 건지...", "clueType": "suspect_cluster" },
    { "id": "house_13", "address": "루퍼트 가 44번지", "x": 1720, "y": 1210, "deaths": 0, "primaryPump": "pump_rupert", "residentName": "다니엘 크로스", "interviewText": "소호 중심가에서 사람들이 죽어 나간다는 소문은 들었소. 하지만 우리 남쪽 거리는 평온하오. 우리는 집 앞 펌프 물만 쓰고 아무 데도 안 가오.", "clueType": "normal" },
    { "id": "house_14", "address": "티치본 가 17번지", "x": 1150, "y": 1720, "deaths": 0, "primaryPump": "pump_tichborne", "residentName": "에마 힐", "interviewText": "골목 하나 차이로 생사가 갈린다니 무섭네요. 우리 집은 이쪽 남서쪽 펌프만 이용하는데 아무도 앓지 않았어요.", "clueType": "normal" },
    { "id": "house_15", "address": "브로드 가 50번지 라이온 양조장", "x": 1409, "y": 928, "deaths": 0, "primaryPump": "own_well", "residentName": "윌리엄 휴잇 (양조장 감독관)", "interviewText": "우리 공장 인부 70명 중 아픈 사람은 단 한 명도 없소! 공장 굴뚝에서 연기가 펄펄 나고 종일 술 냄새를 맡으며 일하니 독기운이 다 날아간 모양이지! 인부들은 일할 때 공짜 맥주만 퍼마시느라 바깥 펌프 물 따윈 쳐다보지도 않는다오!", "clueType": "brewery_anomaly" },
    { "id": "house_16", "address": "폴란드 가 세인트 제임스 구빈원", "x": 1066, "y": 756, "deaths": 5, "primaryPump": "own_well", "residentName": "에드워드 심스 (구빈원 관리인)", "interviewText": "가난한 수용자 500명이 살을 맞대고 살고 있소. 악취가 코를 찔러 숨쉬기도 역겹지만 다행히 앓아누운 이는 극소수요. 우린 성문 밖으로 나가지 않고 마당 깊은 전용 우물물만 긷거든.", "clueType": "workhouse_anomaly" },
    { "id": "house_17", "address": "소호 외곽 햄스테드 마차 연락소", "x": 280, "y": 320, "deaths": 1, "primaryPump": "pump_broad", "residentName": "하녀 베시", "interviewText": "마님께선 시골 공기 맑은 전원저택에 사셨는데 갑자기 변을 당하셨어요. 소호에서 장사하는 아드님이 마차 편으로 소호 물품들을 보내오셨는데, 유독 브로드 가 물맛을 좋아하셔서 물통까지 실어 보내셨거든요...", "clueType": "hampstead_anomaly" },
    { "id": "house_18", "address": "브로드 가 45번지", "x": 1234, "y": 1040, "deaths": 4, "primaryPump": "pump_broad", "residentName": "로버트 게이츠", "interviewText": "간이식당을 합니다. 손님들에게 큰길가 펌프 물로 끓인 홍차를 내놓았는데, 며칠 만에 단골손님 여럿이 다시는 찾아오지 못했습니다...", "clueType": "suspect_cluster" },
    { "id": "house_19", "address": "마셜 가 6번지", "x": 1160, "y": 1120, "deaths": 2, "primaryPump": "pump_broad", "residentName": "캐서린 부스", "interviewText": "펌프에서 몇 발자국 안 되는 곳이라 하루에도 서너 번씩 물을 길었습니다. 그 시원하던 물이 독이었을 줄이야...", "clueType": "suspect_cluster" },
    { "id": "house_20", "address": "딘 가 33번지", "x": 650, "y": 1080, "deaths": 1, "primaryPump": "pump_broad", "residentName": "존 맥도널드", "interviewText": "우리 골목에도 펌프가 있는데, 어머니께선 브로드 가 물이 더 맑고 톡 쏜다며 늘 저쪽까지 가서 물을 길어오셨습니다. 그 물을 드시고 결국...", "clueType": "suspect_cluster" }
  ],
